#!/usr/bin/env sh
# CRIT spec pre-commit hook
# Runs the unified test suite and blocks the commit if any MUST-level rule fails.
# Generates a dated Markdown report in tests/reports/.

set -e

echo "=== CRIT pre-commit: running spec conformance tests ==="
go run ./tests/cmd/crit-test --report tests/reports

# Stage the report the run just produced.
#
# Without this the hook rewrote the report on every commit, stamped it with a
# new timestamp and content hash, and left it unstaged: the working tree was
# dirty the moment any commit finished, and committing that report dirtied it
# again. The repository could not be clean.
#
# Staging it also keeps the committed report matching the code in the same
# commit, which is the whole reason it is generated here rather than in CI.
git add tests/reports/crit-test-report.md

echo "=== CRIT pre-commit: validating samples schema ==="
check-jsonschema --schemafile schemas/crit-samples-v0.1.0.schema.json tests/CRIT-samples.json

echo ""
echo "CRIT conformance tests passed."
